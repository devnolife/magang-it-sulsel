# Salin ke .env lalu isi. Jangan commit .env.

# ── Aplikasi web (laptop & VPS) ─────────────────────────────────────────
# Lokasi file SQLite. Di VPS disarankan /var/lib/magang-it-sulsel/app.db
DATABASE_PATH=./var/app.db
# URL publik situs, dipakai untuk canonical, sitemap, dan CSV. Wajib diisi di VPS (di balik Caddy).
# Contoh tanpa domain: https://203-0-113-10.sslip.io
ORIGIN=http://localhost:3000
# Alamat server Node untuk `npm start`. Di VPS cukup dengarkan 127.0.0.1; Caddy yang melayani publik.
# HOST=127.0.0.1
# PORT=3000
# Opsional: email pengelola untuk yang tidak punya akun GitHub. Tampil publik di /usulkan & /tentang.
# PUBLIC_KONTAK_EMAIL=

# ── Pipeline data (hanya di laptop) ─────────────────────────────────────
# copilot-text-shim (OpenAI-compatible) untuk klasifikasi kasus ragu
SHIM_URL=http://127.0.0.1:8787/v1
SHIM_TOKEN=copilot-local
SHIM_MODEL=copilot
# Chrome khusus pipeline (terpisah dari Hunter 9333 & jev 9334)
CDP_PORT=9335
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PROFILE=C:\Users\<nama>\.magang-it-sulsel\chrome-profile
