# Salin ke .env lalu isi. Jangan commit .env.

# ── Aplikasi web (laptop & VPS) ─────────────────────────────────────────
# Lokasi file SQLite. Di VPS disarankan /var/lib/magang-it-sulsel/app.db
DATABASE_PATH=./var/app.db
# URL publik situs (wajib untuk `node build`/adapter-node). Contoh VPS: https://1-2-3-4.sslip.io
ORIGIN=http://localhost:3000
# Hash password admin: jalankan `npm run admin:hash` lalu tempel hasilnya di sini.
ADMIN_PASSWORD_HASH=
# String acak panjang (min. 32 karakter), mis. hasil `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# String acak lain untuk hash IP pengirim (rate limit tanpa menyimpan IP mentah)
IP_HASH_SALT=
# Di balik Caddy/Nginx: ambil IP asli dari header ini
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# BODY_SIZE_LIMIT=64K

# ── Pipeline data (hanya di laptop) ─────────────────────────────────────
# copilot-text-shim (OpenAI-compatible) untuk klasifikasi kasus ragu
SHIM_URL=http://127.0.0.1:8787/v1
SHIM_TOKEN=copilot-local
SHIM_MODEL=copilot
# Chrome khusus pipeline (terpisah dari Hunter 9333 & jev 9334)
CDP_PORT=9335
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PROFILE=C:\Users\<nama>\.magang-it-sulsel\chrome-profile
